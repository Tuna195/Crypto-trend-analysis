# Sử dụng Python 3.11 làm nền tảng (Bản Bookworm hỗ trợ sẵn Java 17)
FROM python:3.11-slim-bookworm

# Cài đặt Java 17 (JRE) vì PySpark 3.5.1 không tương thích với Java 21
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jre-headless procps && \
    rm -rf /var/lib/apt/lists/*

# Thiết lập thư mục làm việc
WORKDIR /app

# Copy file requirements và cài đặt
COPY requirements-stream.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-stream.txt

# Copy toàn bộ source code
COPY src/ ./src/

# Tạo user không có đặc quyền root để bảo mật
RUN useradd --no-create-home --shell /bin/false appuser && \
    chown -R appuser:appuser /app
USER appuser
